# Django Secret Key
SECRET_KEY=your-secret-key-here

# Debug Mode (set to False in production)
DEBUG=True

# Main Domain
MAIN_DOMAIN=multilang.uz

# Set this only when the app is served behind a path proxy such as code-server.
# Example: APP_URL_PREFIX=/proxy/8003
APP_URL_PREFIX=

# Comma-separated HTTPS origins allowed to submit forms through a proxy.
# Example: CSRF_TRUSTED_ORIGINS=https://dk-dev.saminjonov.uz
CSRF_TRUSTED_ORIGINS=

# Database Configuration
# Set to 'true' to use PostgreSQL, or 'false' to use SQLite
USE_POSTGRES=true

# PostgreSQL Database Settings (only used if USE_POSTGRES=true)
DB_NAME=wowdash_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# Telegram Bot Configuration (if applicable)
# BOT_TOKEN=your_bot_token_here
