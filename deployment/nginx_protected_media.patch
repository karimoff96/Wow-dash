+    location /protected-media/ {
+        internal;
+        alias /home/Wow-dash/media/;
+    }
+
+    # These paths must never fall through to the public media alias.
+    location ^~ /media/order_media/ { return 404; }
+    location ^~ /media/recipts/ { return 404; }
+    location ^~ /media/receipts/ { return 404; }
+
     # Media files
     location /media/ {
